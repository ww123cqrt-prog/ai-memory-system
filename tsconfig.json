{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["tasks/**/*.ts", "src/sources/types.ts", "src/sources/claude-source.ts", "src/sources/codex-source.ts"],
  "exclude": ["node_modules", "dist", "vendor", "src/bridge", "src/scheduler"]
}
